# Copy this file to .env and fill in your real values
# DO NOT commit the real .env file

# Flask secret key — generate a strong random key for production
FLASK_SECRET_KEY=change-me-to-a-strong-random-secret

# Your deployed site URL (no trailing slash)
# Example: https://securesight.onrender.com
SITE_URL=https://your-app-name.onrender.com

# VirusTotal API Key (optional — for enhanced domain reputation checks)
VT_API_KEY=your-virustotal-api-key-here

# Database (not currently used by main app — reserved for future)
DATABASE_URL=sqlite:///app.db
